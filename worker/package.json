{
  "name": "newsfeed-worker",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "build:local": "esbuild src/entry-local.ts --bundle --platform=node --format=esm --outfile=dist/local.mjs --external:node:sqlite",
    "build:admin": "esbuild src/admin/server.ts --bundle --platform=node --format=esm --outfile=dist/admin.mjs --external:node:sqlite",
    "build": "npm run build:local && npm run build:admin",
    "start:local": "node dist/local.mjs",
    "start:local:cron": "node dist/local.mjs --cron",
    "start:admin": "node dist/admin.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:local": "tsc -p tsconfig.local.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.4",
    "wrangler": "^4.0.0"
  }
}
